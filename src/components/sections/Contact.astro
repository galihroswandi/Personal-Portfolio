---
/** 07 · Contact panel: email (mailto), CV download, social links and the address. */
import SectionHeader from '@/components/sections/SectionHeader.astro';
import Button from '@/components/ui/Button.astro';
import Panel from '@/components/ui/Panel.astro';
import { site } from '@/config/site';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { cvHref, hasCv } from '@/lib/cv';
import { isRealUrl } from '@/lib/placeholders';
import { buildMailto, splitEmail } from '@/lib/mailto';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const mailto = buildMailto({ to: site.email, subject: t('contact.subject') });
const { user, domain } = splitEmail(site.email);
// Profiles that are not set yet (`#`) are left out rather than rendered as dead links.
const socials = [
  { id: 'github', href: site.social.github, label: t('contact.github') },
  { id: 'linkedin', href: site.social.linkedin, label: t('contact.linkedin') },
  { id: 'instagram', href: site.social.instagram, label: t('contact.instagram') },
].filter((social) => isRealUrl(social.href));
---

<section id="kontak" class="container section section--last contact" aria-labelledby="kontak-title">
  <Panel class="contact__panel reveal-brackets" data-reveal>
    <SectionHeader
      titleId="kontak-title"
      num={t('section.contact.num')}
      label={t('section.contact.label')}
      title={t('section.contact.title')}
      sub={t('section.contact.sub')}
    />
    <div class="contact__actions">
      <Button href={mailto} arrow data-event="email_click" data-event-label="contact">
        {t('contact.email')}
      </Button>
      {hasCv(lang) && (
        <Button
          href={cvHref(lang)}
          variant="secondary"
          download
          data-cv-open
          data-event="cv_preview"
          data-event-label="contact"
        >
          {t('contact.cv')}
        </Button>
      )}
    </div>
    <div class="contact__links">
      {socials.length > 0 && (
        <ul class="contact__social" aria-label={t('a11y.social')}>
          {socials.map((social) => (
            <li>
              <!-- rel="me": these are the owner's own profiles (identity link, followed). -->
              <a
                href={social.href}
                rel="me noopener"
                data-event="profile_click"
                data-event-label={social.id}
              >
                {social.label}
              </a>
            </li>
          ))}
        </ul>
      )}
      <!-- The visible address is assembled in the browser so it is not plain text in the HTML. -->
      <a
        class="contact__email"
        href={mailto}
        data-email-user={user}
        data-email-domain={domain}
        data-event="email_click"
        data-event-label="address"
      >
        {domain ? `${user} [at] ${domain}` : user}
      </a>
    </div>
  </Panel>
</section>

<script>
  for (const link of document.querySelectorAll<HTMLElement>('[data-email-user]')) {
    const { emailUser, emailDomain } = link.dataset;
    if (emailUser && emailDomain) link.textContent = `${emailUser}@${emailDomain}`;
  }
</script>

<style>
  .contact :global(.contact__panel) {
    padding: var(--space-6) var(--space-5);
    border: var(--hairline-width) solid var(--hairline);
    border-radius: var(--radius-xl);
    background: var(--surface-raised);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
  }

  .contact__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    padding: 0;
    list-style: none;
  }

  .contact__social a,
  .contact__email {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    color: var(--accent-ink);
    font-size: 0.875rem;
    font-weight: 500;
    text-underline-offset: var(--space-1);
  }

  .contact__email {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  @media (min-width: 721px) {
    .contact :global(.contact__panel) {
      padding: var(--space-8);
    }
  }
</style>
