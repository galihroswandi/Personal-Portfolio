---
/** 02 · About: photo, two paragraphs (MDX), three principles, bento summary. */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BentoTile from '@/components/cards/BentoTile.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import Panel from '@/components/ui/Panel.astro';
import type { Lang, UIKey } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { getAbout } from '@/lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const about = await getAbout(lang);
const { Content } = await render(about);
const { photo } = about.data;

const principles: { title: UIKey; text: UIKey }[] = [
  { title: 'about.principle1.title', text: 'about.principle1.text' },
  { title: 'about.principle2.title', text: 'about.principle2.text' },
  { title: 'about.principle3.title', text: 'about.principle3.text' },
];
---

<section id="tentang" class="container section" aria-labelledby="tentang-title">
  <SectionHeader
    titleId="tentang-title"
    num={t('section.about.num')}
    label={t('section.about.label')}
    title={t('section.about.title')}
  />

  <div class="about">
    <Panel as="figure" class="about__photo">
      {photo ? (
        <Image src={photo} alt={t('about.photoAlt')} widths={[300, 600]} sizes="300px" />
      ) : (
        <div class="about__placeholder" role="img" aria-label={t('about.photoAlt')}>
          <span aria-hidden="true">{t('about.photoPlaceholder')}</span>
        </div>
      )}
    </Panel>

    <div class="about__text">
      <div class="about__prose">
        <Content />
      </div>
      <ul class="about__principles">
        {principles.map((principle) => (
          <li>
            <p class="about__principle-title">{t(principle.title)}</p>
            <p class="about__principle-text">{t(principle.text)}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="bento">
    <BentoTile
      variant="accent"
      cols={2}
      rows={2}
      large
      label={t('bento.experience.label')}
      value={t('bento.experience.value')}
      note={t('bento.experience.note')}
    />
    <BentoTile label={t('bento.stack.label')} value={t('bento.stack.value')} />
    <BentoTile
      variant="sunken"
      label={t('bento.location.label')}
      value={t('bento.location.value')}
      note={t('bento.location.note')}
    />
    <BentoTile
      variant="inverse"
      cols={2}
      label={t('bento.learning.label')}
      value={t('bento.learning.value')}
      note={t('bento.learning.note')}
    />
  </div>
</section>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: var(--space-7);
  }

  .about :global(.about__photo) {
    width: 100%;
    max-width: var(--photo-width);
    aspect-ratio: 4 / 5;
    overflow: visible;
    border: var(--hairline-width) solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--surface-sunken);
  }

  .about :global(.about__photo img),
  .about__placeholder {
    width: 100%;
    height: 100%;
    border-radius: inherit;
  }

  .about :global(.about__photo img) {
    object-fit: cover;
  }

  .about__placeholder {
    display: grid;
    place-items: center;
    color: var(--ink-subtle);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .about__text {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: var(--space-6);
    min-width: 0;
  }

  .about__prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--measure-text);
  }

  .about__prose :global(p:first-child) {
    color: var(--ink);
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .about__prose :global(p + p) {
    color: var(--ink-muted);
  }

  .about__principles {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5) 0 0;
    border-top: var(--hairline-width) solid var(--hairline);
    list-style: none;
  }

  .about__principle-title {
    color: var(--accent-ink);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .about__principle-text {
    margin-top: var(--space-2);
    color: var(--ink-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  @media (min-width: 721px) {
    .about__principles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: minmax(var(--bento-row), auto);
    }
  }

  @media (min-width: 1024px) {
    .about {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-7);
    }

    .about :global(.about__photo) {
      flex: 0 0 var(--photo-width);
    }
  }
</style>
