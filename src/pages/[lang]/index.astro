---
import type { GetStaticPaths } from 'astro';
import About from '@/components/sections/About.astro';
import CaseStudies from '@/components/sections/CaseStudies.astro';
import Contact from '@/components/sections/Contact.astro';
import Experience from '@/components/sections/Experience.astro';
import Hero from '@/components/sections/Hero.astro';
import Services from '@/components/sections/Services.astro';
import type { Lang } from '@/i18n/ui';
import { langs, useTranslations } from '@/i18n/utils';
import Base from '@/layouts/Base.astro';
import { getProjects } from '@/lib/content';

export const getStaticPaths = (() =>
  langs.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const projects = await getProjects(lang, { featuredOnly: true });
---

<Base title={t('meta.title')} description={t('meta.description')}>
  <Hero lang={lang} />
  <CaseStudies lang={lang} projects={projects} />
  <About lang={lang} />
  <Experience lang={lang} />
  <Services lang={lang} />
  <Contact lang={lang} />
</Base>
