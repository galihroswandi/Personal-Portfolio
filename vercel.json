{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": { "eq": "galihroswandi.vercel.app" } }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    {
      "source": "/:lang(id|en)/proyek/dasbor-pemantauan/",
      "destination": "/:lang/proyek/command-center-maritim/",
      "permanent": true
    }
  ]
}
